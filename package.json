{
  "name": "amendoas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "node --test test/*.test.mjs",
    "build:web": "npm run build && esbuild dist/tracking-ui.js --bundle --format=esm --target=safari15.4,chrome92 --outfile=dist/acompanhamento-web/acompanhamento.js && node web/build-pwa.mjs",
    "build:apk": "bash android/build.sh",
    "build:apk:web": "npm run build && node android/homologacao/build-web.mjs",
    "build:apk:homologacao": "bash android/build.sh homologacao"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
